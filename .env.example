# GitHub Personal Access Token with appropriate permissions
# Create one at https://github.com/settings/tokens
# Required scopes: repo, read:user, user:email
# See README.md for detailed instructions on creating a token
GITHUB_TOKEN=your_github_token_here

# Your GitHub username
# This is used to identify your contributions in the organization
GITHUB_USERNAME=your_github_username_here

# GitHub organization name
# This is the organization whose repositories will be analyzed
GITHUB_ORG=your_organization_name_here

# Note: This file is an example. Copy it to .env and fill in your actual values.
# DO NOT commit your actual .env file to version control!
